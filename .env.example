# Mama Pedhewale Environment Variables Template
# Copy this file to .env for local testing (never commit .env)
# Or enter these in your hosting dashboard (e.g. Render, Railway, Heroku)

# Flask Secret Key
SECRET_KEY=mama-pedhewale-secret-key-1948

# Admin Portal Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=MamaSatara@1948
