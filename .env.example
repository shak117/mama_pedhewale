# Mama Pedhewale Environment Variables Template
# Copy this file to .env for local testing (never commit .env to GitHub)
# Or configure these in your hosting dashboard (e.g. Vercel, Render, Railway)

# Flask Secret Key
SECRET_KEY=mama-pedhewale-secret-key-1948

# Admin Portal Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=MamaSatara@1948
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=MamaSuper@1948

# Razorpay Payment Gateway Credentials
# Generate in Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (Configure in Razorpay Dashboard -> Settings -> Webhooks)
# Webhook URL: https://<your-domain>/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Shiprocket Shipping Logistics Credentials
# Base URL: https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_WEBHOOK_SECRET=
# Configured Pickup Location nickname exactly as registered in Shiprocket Dashboard -> Settings -> Pickup Address (REQUIRED)
SHIPROCKET_PICKUP_LOCATION=
# Pickup Pincode of your kitchen/warehouse in Satara (defaults to 415003 if omitted)
SHIPROCKET_PICKUP_PINCODE=415003
# Automatically create Shiprocket orders on confirmed payment / COD (keep false for manual admin creation)
SHIPROCKET_AUTO_CREATE=false
